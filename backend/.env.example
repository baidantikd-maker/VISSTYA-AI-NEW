# Copy this file to .env and fill in real values before starting the server.
OAUTH_SERVER_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
JWT_SECRET=YOUR_JWT_SECRET
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Supabase -----------------------------------------------------
# Supabase Project Settings -> API. The service role key must never ship to
# the browser; it is used server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_STORAGE_BUCKET=media

# NewsAPI.org key for the evidence corroboration module.
NEWS_API_KEY=YOUR_NEWS_API_KEY

# --- S3-compatible storage (optional) --------------------------------
# Leave these unset to keep using Supabase Storage for media uploads.
# Works with AWS S3, Cloudflare R2, MinIO, and Supabase's S3 gateway.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=visstya-media
# S3_PUBLIC_BASE_URL=https://media.example.com

# --- Manus / Forge services (optional helpers) ------------------------
# Used by llm.ts, dataApi.ts, map.ts, heartbeat.ts, imageGeneration.ts.
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# OWNER_OPEN_ID=
