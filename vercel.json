{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/**",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/api/index.mjs" },
    { "source": "/:path*", "destination": "/api/index.mjs" }
  ]
}
